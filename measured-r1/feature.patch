+            logger.debug("event %s free blocks: %s", event_id, block_ids)
+            self._block_pool.free_blocks([self._block_pool.blocks[block_id] for block_id in reversed(block_ids)])
+
+    def close(self) -> None:
+        for job_id in self._pending_key_saves:
+            self._release_sending_event(job_id)
+        self._pending_key_saves.clear()
+        if self.client is not None:
+            self.client.close()
+        self.store_scheduler.close()
